---
import { file, href, rows } from '../../data/waitlist';
import { getLang, translator } from '../../i18n';

/**
 * “Ingeniería de software”: at first the letters are laughing (wobbly,
 * thin, crooked). As you scroll they straighten up and gain weight: it is taken seriously.
 * Meanwhile, next to it, a real Apollo 11 routine is typed out step by step:
 * first its specification, then its code. It finishes just as the term straightens up.
 */
const t = translator(getLang(Astro));
const term = t({ es: ['Ingeniería', 'de software'], en: ['Software', 'engineering'] });

const rand = (i: number) => {
	const x = Math.sin(i * 78.233 + 1.7) * 43758.5453;
	return x - Math.floor(x);
};

let i = 0;
const total = term.join('').replace(/ /g, '').length;
const words = term.map((line) =>
	line.split(' ').map((word) =>
		word.split('').map((char) => {
			const n = i++;
			return {
				char,
				r: ((rand(n) - 0.5) * 50).toFixed(1),
				y: ((rand(n + 99) - 0.5) * 0.7).toFixed(2),
				d: (n / (total - 1)).toFixed(3),
				jd: (rand(n + 7) * -1.2).toFixed(2),
			};
		}),
	),
);
---

<section
	class="scene ingenieria"
	data-scene="ingenieria"
	data-theme="blueprint"
	data-year="1969"
	data-p-range="0.3 0.58"
	style="--len: 460"
>
	<div class="stage">
		<div class="grid" aria-hidden="true"></div>

		<figure class="listing still">
			<figcaption class="listing-head mono">
				<span>LUMINARY 099</span>
				<a href={href} target="_blank" rel="noopener">{file}</a>
				<span class="sr-only">
					{
						t({
							es: 'La especificación y el código de WAITLIST, el planificador de tareas del módulo lunar del Apollo 11.',
							en: 'The specification and code of WAITLIST, the task scheduler of the Apollo 11 lunar module.',
						})
					}
				</span>
			</figcaption>
			<div class="window">
				<div class="code" data-code aria-hidden="true">
					{
						rows.map((row) =>
							row === 'gap' ? (
								<span class="row gap" data-row>
									<span class="n" />
									<span class="src">
										<span>⋮</span>
									</span>
								</span>
							) : (
								<span class="row" data-row>
									<span class="n">{row.n}</span>
									<span class="src">
										{row.tokens.map(({ k, s }) => (
											<span class={k}>{s}</span>
										))}
									</span>
								</span>
							),
						)
					}
				</div>
			</div>
		</figure>

		<h2 class="term">
			<span class="sr-only">{term.join(' ')}</span>
			{
				words.map((line) => (
					<span class="term-line" aria-hidden="true">
						{line.map((word, wi) => (
							<>
								<span class="w">
									{word.map(({ char, r, y, d, jd }) => (
										<span class="l" style={`--l-r:${r}deg;--l-y:${y}em;--l-d:${d};--jd:${jd}s`}>
											{char}
										</span>
									))}
								</span>
								{wi < line.length - 1 && ' '}
							</>
						))}
					</span>
				))
			}
		</h2>

		<div class="text stack">
			<p class="beat" data-beat="0 0.32">
				{
					t({
						es: 'Margaret empezó a llamar así a su trabajo. Durante mucho tiempo, fue una broma.',
						en: 'Margaret started calling her work that. For a long time, it was a joke.',
					})
				}
			</p>
			<p class="beat" data-beat="0.32 0.6">{t({ es: 'Hasta que dejó de serlo.', en: 'Until it wasn’t.' })}</p>
			<p class="beat" data-beat="0.6 0.78">{t({ es: 'Hoy es el nombre de nuestra profesión.', en: 'Today it’s the name of our profession.' })}</p>
			<blockquote class="beat quote" data-beat="0.78">
				<p>
					{
						t({
							es: '«El software acabó ganándose, por necesidad, el mismo respeto que cualquier otra disciplina».',
							en: '“Software eventually and necessarily gained the same respect as any other discipline.”',
						})
					}
				</p>
				<footer>{t({ es: 'Margaret Hamilton, en El País, 2018', en: 'Margaret Hamilton, to El País, 2018' })}</footer>
			</blockquote>
		</div>
	</div>
</section>

<script>
	import { $, $$ } from '../../scripts/dom';
	import { onProgress, onWarm, segment } from '../../scripts/scroll';

	// Part of the scene in which the listing is typed: it ends once the term is upright
	const TYPE_FROM = 0.02;
	const TYPE_TO = 0.58;

	const scene = $('[data-scene="ingenieria"]')!;
	const code = $('[data-code]', scene)!;
	const view = code.parentElement!;

	// Each line costs its characters plus one, the line break
	let total = 0;
	const rows = $$('[data-row]', scene).map((row) => {
		const parts = $$('.src > span', row);
		const full = parts.map((part) => part.textContent ?? '');
		const nodes = parts.map((part) => {
			let node = part.firstChild as Text | null;
			if (!node) {
				node = document.createTextNode('');
				part.append(node);
			}
			return node;
		});
		const len = full.join('').length;
		const start = total;
		total += len + 1;
		return { row, nodes, full, len, start, shown: len, on: false, bottom: 0 };
	});

	// Once every letter is upright, the wobble has nothing left to do
	const term = $('.term', scene)!;
	let isUpright = false;

	let active = rows[0];
	let lastTyped = -1;
	let lastY = NaN;
	let isScrolled = false;
	let isTyping = false;
	let viewHeight = 0;
	let idle = 0;

	// Pre-measure row offsets when the scene warms up or resizes so scroll frames never read layout
	onWarm(scene, () => {
		if (lastTyped !== -1) {
			for (const r of rows) {
				if (r.shown !== r.len) {
					r.nodes.forEach((node, i) => (node.nodeValue = r.full[i]));
					r.shown = r.len;
				}
			}
			lastTyped = -1;
			lastY = NaN;
		}
		viewHeight = view.clientHeight;
		for (const r of rows) {
			r.bottom = r.row.offsetTop + r.row.offsetHeight;
		}
	});

	onProgress(scene, (p) => {
		const upright = p >= 0.58;
		if (upright !== isUpright) {
			isUpright = upright;
			term.classList.toggle('is-upright', upright);
		}

		const typed = Math.floor(segment(p, TYPE_FROM, TYPE_TO) * total);
		if (typed === lastTyped) return;
		lastTyped = typed;

		let current = rows[0];
		for (const r of rows) {
			const on = typed >= r.start;
			if (on) current = r;
			if (r.on !== on) {
				r.on = on;
				r.row.classList.toggle('is-on', on);
			}
			if (!on) continue;
			const count = Math.min(r.len, typed - r.start);
			if (count === r.shown) continue;
			r.shown = count;
			let left = count;
			r.nodes.forEach((node, i) => {
				node.nodeValue = r.full[i].slice(0, Math.max(0, left));
				left -= r.full[i].length;
			});
		}

		if (current !== active) {
			active.row.classList.remove('is-active');
			active = current;
			active.row.classList.add('is-active');
		} else if (!active.row.classList.contains('is-active')) {
			active.row.classList.add('is-active');
		}

		// Like an editor: the listing scrolls up so the line being typed stays inside the window
		const y = Math.round(Math.max(0, active.bottom - viewHeight * 0.78) * 10) / 10;
		if (y !== lastY) {
			lastY = y;
			code.style.transform = `translate3d(0, ${-y}px, 0)`;
			const scrolled = y > 0;
			if (scrolled !== isScrolled) {
				isScrolled = scrolled;
				view.classList.toggle('is-scrolled', scrolled);
			}
		}

		// The caret only blinks once typing stops
		if (!isTyping) {
			isTyping = true;
			code.classList.add('is-typing');
		}
		clearTimeout(idle);
		idle = window.setTimeout(() => {
			isTyping = false;
			code.classList.remove('is-typing');
		}, 450);
	});
</script>

<style>
	@property --grid-o {
		syntax: '<number>';
		inherits: false;
		initial-value: 1;
	}

	.stage {
		display: grid;
		grid-template-rows: 1fr auto;
		align-items: center;
		padding: 8vh var(--gutter) clamp(3.5rem, 12vh, 8rem);
	}

	/* Blueprint grid that appears when the term is taken seriously */
	.grid {
		--grid-o: clamp(0, calc((var(--p, 1) - 0.3) / 0.28), 1);
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px) 0 0 / 2rem 2rem,
			linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px) 0 0 / 2rem 2rem;
		opacity: var(--grid-o);
	}

	.term {
		position: relative;
		width: 100%;
		height: 1.9em;
		font-size: clamp(3rem, 0.6rem + 10.5vw, 12rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.03em;
		contain: strict;
	}

	.term-line {
		display: block;
	}

	.w {
		display: inline-block;
		white-space: nowrap;
	}

	/* Typed, the letters' values don't have to be parsed again on every restyle. @property is global,
	   so the names carry the letters' prefix: a bare --y here turned the stickers' `--y: 56%` into 0px */
	@property --l-k {
		syntax: '<number>';
		inherits: false;
		initial-value: 0;
	}
	@property --l-wobble {
		syntax: '<angle>';
		inherits: false;
		initial-value: 7deg;
	}
	@property --l-d {
		syntax: '<number>';
		inherits: false;
		initial-value: 0;
	}
	@property --l-y {
		syntax: '<length>';
		inherits: false;
		initial-value: 0px;
	}
	@property --l-r {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}

	/* The wobble goes on `rotate` so it adds on top of `transform`, which holds the crooked pose */
	.l {
		--l-k: clamp(0, calc((var(--p, 1) - 0.3 - var(--l-d) * 0.16) / 0.12), 1);
		--l-wobble: calc((1 - var(--l-k)) * 7deg);
		display: inline-block;
		font-weight: calc(300 + 300 * round(var(--l-k)));
		transform: translateY(calc(var(--l-y) * (1 - var(--l-k)))) rotate(calc(var(--l-r) * (1 - var(--l-k))));
		animation: jig 0.42s ease-in-out var(--jd) infinite alternate;
	}

	.is-upright .l {
		animation: none;
	}

	@keyframes jig {
		from {
			rotate: calc(-1 * var(--l-wobble));
		}
		to {
			rotate: var(--l-wobble);
		}
	}

	/* The listing, to the right of the term, like a specification sheet */
	.listing {
		--mark: #fbe46a;
		position: absolute;
		top: clamp(4.5rem, 12vh, 8rem);
		bottom: calc(clamp(3.5rem, 12vh, 8rem) + var(--chrome));
		right: var(--gutter);
		width: min(40vw, 46rem);
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		container-type: inline-size;
	}

	.listing-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid rgb(255 255 255 / 0.22);
		color: var(--fg-dim);
	}

	.listing-head a {
		color: var(--fg);
	}

	.window {
		position: relative;
		overflow: hidden;
		contain: strict;
		mask-image: linear-gradient(transparent, #000 2rem);
	}

	/* 78 columns of code plus the line number fit the width of the listing */
	.code {
		position: relative;
		padding-top: 2rem;
		font-family: var(--font-mono);
		font-size: clamp(0.5625rem, 1.95cqw, 0.875rem);
		line-height: 1.6;
		transition: transform 0.35s var(--ease-out);
		will-change: transform;
	}

	.row {
		display: flex;
		contain: layout style;
	}

	:global(.js) .row:not(.is-on) {
		visibility: hidden;
	}

	.n {
		flex: 0 0 3ch;
		margin-right: 2ch;
		text-align: right;
		color: var(--fg-dim);
		opacity: 0.6;
	}

	/* If a line doesn't fit, it continues below, indented */
	.src {
		flex: 1;
		min-width: 0;
		padding-left: 2ch;
		text-indent: -2ch;
		white-space: pre-wrap;
	}

	.doc,
	.note,
	.gap .src {
		color: var(--fg-dim);
	}

	.head {
		font-weight: 500;
	}

	.label {
		color: var(--mark);
		font-weight: 500;
	}

	.is-active .src::after {
		content: '';
		display: inline-block;
		width: 1ch;
		height: 1.25em;
		margin-left: 1px;
		vertical-align: -0.25em;
		background: var(--fg);
	}

	.code:not(.is-typing) .is-active .src::after {
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.text p,
	.quote p {
		max-width: 26ch;
		font-size: var(--t-lead);
		line-height: 1.12;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.quote footer {
		margin-top: 1rem;
		color: var(--fg-dim);
		font-size: var(--t-body);
	}

	/* Leaves room for the listing: the widest line, bold “engineering”, is 5.14em */
	@media (min-width: 1200px) {
		.term {
			font-size: min(9.2vw, 12rem);
		}
	}

	/* On narrow screens the listing takes the top of the stage, above the term */
	@media (max-width: 1199px) {
		.stage {
			grid-template-rows: auto 1fr auto;
		}

		.listing {
			position: relative;
			inset: auto;
			width: auto;
			height: clamp(9rem, 30vh, 18rem);
		}

		.code {
			font-size: clamp(0.5625rem, 1.95cqw, 0.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.l,
		.code:not(.is-typing) .is-active .src::after {
			animation: none;
		}

		.code {
			transition: none;
		}
	}

	html:not(.js) .l {
		transform: none;
		font-weight: 600;
		animation: none;
	}

	html:not(.js) .window {
		overflow: auto;
	}
</style>
